{
  "name": "golangci-lint-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed-cache": "tsx scripts/seed-cache.ts",
    "write-versions": "tsx scripts/write-versions.ts",
    "parity": "tsx scripts/parity.ts",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.2",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.8",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.44.0",
    "@lezer/highlight": "1.2.5",
    "codemirror": "6.0.2",
    "yaml": "2.8.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.30",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
