nolint ディレクティブ
//nolint で指摘を抑え、nolintlint で //nolint の書き方を検査します。
-- main.go --
package main

import "os"

func main() {
	os.Remove("a") //nolint:errcheck // 失敗しても問題ない
	os.Remove("b") //nolint
	os.Remove("c") //nolint:gosec
}
-- .golangci.yml --
version: "2"
linters:
  enable:
    - nolintlint
  settings:
    nolintlint:
      require-explanation: true
      require-specific: true
