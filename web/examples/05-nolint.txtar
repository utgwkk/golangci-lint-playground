nolint directives
Suppress issues with //nolint, and check how //nolint is written with nolintlint.
-- main.go --
package main

import "os"

func main() {
	os.Remove("a") //nolint:errcheck // failing is fine here
	os.Remove("b") //nolint
	os.Remove("c") //nolint:gosec
}
-- .golangci.yml --
version: "2"
linters:
  enable:
    - nolintlint
  settings:
    nolintlint:
      require-explanation: true
      require-specific: true
