A module with go.mod and several files and packages. Switch between files with the tabs.
-- go.mod --
module example.com/app

go 1.27
-- main.go --
package main

import (
	"fmt"

	"example.com/app/internal/store"
)

func main() {
	s := store.New()
	s.Put("k", "v")
	fmt.Println(s.Get("k"))
}
-- internal/store/store.go --
package store

import "os"

type Store struct{ m map[string]string }

func New() *Store { return &Store{m: map[string]string{}} }

func (s *Store) Put(k, v string) {
	s.m[k] = v
	os.Remove("/tmp/" + k)
}

func (s *Store) Get(k string) string { return s.m[k] }
