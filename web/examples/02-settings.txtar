Linter settings and exclusions
Tune linters with linters.settings and exclude specific issues with linters.exclusions.
-- main.go --
package main

import (
	"fmt"
	"os"
)

func handle(v any) {
	s := v.(string)
	fmt.Println(s)
}

func main() {
	os.Setenv("MODE", "debug")
	handle("x")
	if len(os.Args) > 1 {
		fmt.Println("args")
	} else {
		fmt.Println("no args")
	}
}
-- .golangci.yml --
version: "2"
linters:
  enable:
    - gocritic
    - forcetypeassert
  settings:
    errcheck:
      # Also report type assertions whose ok value is not checked.
      check-type-assertions: true
    gocritic:
      enabled-tags: [diagnostic, style]
  exclusions:
    rules:
      # Allow if-else chains in main.go.
      - path: main\.go
        linters: [gocritic]
        text: ifElseChain
