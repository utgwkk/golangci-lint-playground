Linter settings and exclusions written freely in .golangci.yml.
-- main.go --
package main

import (
	"fmt"
	"os"
)

func handle(v interface{}) {
	s := v.(string)
	fmt.Println(s)
}

func main() {
	os.Setenv("A", "B")
	handle("x")
	if len(os.Args) > 1 {
		fmt.Println("args")
	} else {
		fmt.Println("no args")
	}
}
-- generated.go --
// Code generated by hand. DO NOT EDIT.

package main

func unused() { _ = 1 }
-- .golangci.yml --
version: "2"
output:
  formats:
    text:
      path: stdout
linters:
  enable:
    - gocritic
    - revive
    - forcetypeassert
  settings:
    errcheck:
      check-type-assertions: true
    gocritic:
      enable-all: true
    revive:
      rules:
        - name: use-any
  exclusions:
    rules:
      - path: main.go
        linters: [gocritic]
        text: "ifElseChain"
